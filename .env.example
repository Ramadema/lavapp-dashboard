# URL de la planilla de Google en formato CSV.
#
# Opcion A (la mas simple, si la planilla esta compartida como
# "cualquiera con el enlace puede ver"): tomar el ID y el gid de la URL de
# edicion y armar la URL de export.
#
#   edicion: https://docs.google.com/spreadsheets/d/<ID>/edit?gid=<GID>#gid=<GID>
#   export:  https://docs.google.com/spreadsheets/d/<ID>/export?format=csv&gid=<GID>
#
# Opcion B (mas estable para acceso programatico):
#   Archivo > Compartir > Publicar en la web > formato CSV
#   Queda una URL del tipo .../spreadsheets/d/e/2PACX-.../pub?gid=0&single=true&output=csv
#
# Si esta variable no esta puesta, la app usa data/encuestas.json como respaldo.
# Para desarrollo local, copiar este archivo a .env.local (que esta gitignoreado).
ENCUESTAS_CSV_URL=https://docs.google.com/spreadsheets/d/XXXXX/export?format=csv&gid=0

# Token de la API de Shortcut para la seccion Performance.
#
# Se genera en https://app.shortcut.com/settings/account/api-tokens; alcanza con
# uno de solo lectura.
# Lo lee unicamente lib/shortcut.js, en el servidor: nunca llega al navegador ni
# aparece en ninguna respuesta. Va en .env.local para desarrollo y en
# Vercel > Project Settings > Environment Variables para produccion. Nunca en
# este archivo.
#
# Si esta vacia, /api/performance responde 501 y la pantalla avisa que falta
# conectar Shortcut.
SHORTCUT_API_TOKEN=

# Acceso al backoffice: dos usuarios fijos, "admin" (ve todo) y "visitors" (ve
# solo Performance). Lo que se escribe en el login como usuario es ese nombre;
# la contraseña de cada uno es el valor de estas variables.
#
# Las lee unicamente lib/auth.js, en el servidor: nunca llegan al navegador,
# a un log ni a una respuesta. Van en .env.local para desarrollo y en
# Vercel > Project Settings > Environment Variables para produccion (marcar
# Production y Preview: sin ellas los previews no dejan entrar). Nunca en este
# archivo.
#
# Si falta alguna, el login responde 503 y la pantalla dice cual falta.
BACKOFFICE_ADMIN_PASSWORD=
BACKOFFICE_VISITORS_PASSWORD=

# Secreto con el que se firma la cookie de sesion. Cualquier texto largo y
# aleatorio; generarlo con:
#   openssl rand -base64 32
# Cambiarlo cierra todas las sesiones abiertas.
BACKOFFICE_SESSION_SECRET=
